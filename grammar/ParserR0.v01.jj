options {
	STATIC = false;
}

PARSER_BEGIN(Parser)
package parser;

import java.util.List;
import java.util.ArrayList;

import ast.ASTNode;
import ast.bindings.ASTLet;
import ast.control.ASTIf;
import ast.control.ASTSeq;
import ast.control.ASTWhile;
import ast.functions.ASTApp;
import ast.functions.ASTFun;
import ast.io.ASTPrint;
import ast.io.ASTPrintln;
import ast.literals.ASTBool;
import ast.literals.ASTId;
import ast.literals.ASTInt;
import ast.literals.ASTString;
import ast.literals.ASTUnit;
import ast.memory.ASTAssign;
import ast.memory.ASTCell;
import ast.memory.ASTDeref;
import ast.operators.ASTAnd;
import ast.operators.ASTDif;
import ast.operators.ASTDiv;
import ast.operators.ASTEq;
import ast.operators.ASTGt;
import ast.operators.ASTGteq;
import ast.operators.ASTLt;
import ast.operators.ASTLteq;
import ast.operators.ASTMult;
import ast.operators.ASTNeg;
import ast.operators.ASTNot;
import ast.operators.ASTOr;
import ast.operators.ASTPlus;
import ast.operators.ASTSub;
import ast.structs.ASTMatch;
import ast.structs.ASTStructPattern;
import ast.structs.ASTStructTuple;
import interpreter.environment.Bind;

public class Parser {
	/* nothing */
}

PARSER_END(Parser)


/* ─── SKIP ───────────────────────────────────────────────────────────────── */

SKIP:
{
	  " "
	| "\t"
	| "\r"
	| "\n"
	| < "//" (~["\r", "\n"])* >
	| < "/*" > : ML_COM_NEXT
}

<ML_COM_NEXT> SKIP:
{
	  < "*/" > : DEFAULT
	| < ~[] >
}


/* ─── TOKENS ─────────────────────────────────────────────────────────────── */

TOKEN:
{
	// Keywords
	  < LET:     "let"      >
	| < TRUE:    "true"     >
	| < FALSE:   "false"    >
	| < IF:      "if"       >
	| < ELSE:    "else"     >
	| < WHILE:   "while"    >
	| < MATCH:   "match"    >
	| < CELL:    "cell"     >
	| < FN:      "fn"       >
	| < PRINT:   "print!"   >
	| < PRINTLN: "println!" >

	// Arithmetic operators
	| < PLUS:     "+" >
	| < MINUS:    "-" >
	| < MULTIPLY: "*" >
	| < DIVIDE:   "/" >

	// Comparison operators
	| < EQUAL_TO:        "==" >
	| < NOT_EQUAL_TO:    "~=" >
	| < GREATER_THAN:    ">"  >
	| < LESS_THAN:       "<"  >
	| < GREATER_THAN_EQ: ">=" >
	| < LESS_THAN_EQ:    "<=" >

	// Logical / unary operators
	| < AND: "&&" >
	| < OR:  "||" >
	| < NOT: "~"  >

	// Memory operators
	| < DEREF:  "!" >

	// Delimiters & punctuation
	| < LEFT_PAREN:       "("  >
	| < RIGHT_PAREN:      ")"  >
	| < LEFT_BRACE:       "{"  >
	| < RIGHT_BRACE:      "}"  >
	| < BIND:             "="  >
	| < ASSIGN:           ":=" >
	| < ARROW:            "=>" >
	| < COLON:            ":"  >
	| < SEMICOLON:        ";"  >
	| < DOUBLE_SEMICOLON: ";;" >
	| < COMMA:            ","  >
	| < BAR:              "|"  >

	// Compound / structured literals
	| < UNIT:            "()"                                                               >
	| < TAG:             "#" ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"] )*               >
	| < STRING_LITERAL:  "\"" ( ~["\"","\\"] | "\\" ["n","t","b","r","f","\\","\""] )* "\"" >
	| < IDENTIFIER:      ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"] )*                   >
	| < INTEGER_LITERAL: ( ["0"-"9"] )+                                                     >
}


/* ─── GRAMMAR ─────────────────────────────────────────────────────────────── */

/*
 * Precedence / call chain (high → low):
 *
 *   ParsePrimary
 *     ↑ ParseMultiplicativeOrCall      (* / and function application)
 *       ↑ ParseAdditive                (+ -)
 *         ↑ ParseComparison            (== ~= > < >= <=)
 *           ↑ ParseLogicalAnd          (&&)
 *             ↑ ParseLogicalOr         (||)
 *               ↑ ParseAssignmentExpr  (:=)
 *                 ↑ ParseSequence      (;)
 *                   ↑ ParseLetBinding  (let ... in)
 *                     ↑ ParseProgram
 */

/* ParseProgram ::= EOF | ParseLetBinding ;; */
ASTNode ParseProgram(): /* Start */
{
	ASTNode result;
}
{
	  <EOF>                                          { return null;   }
	| result = ParseLetBinding() <DOUBLE_SEMICOLON>  { return result; }
}

/* ParseLetBinding ::= ParseSequence | ( let id = ParseLogicalOr ; )+ ParseSequence */
ASTNode ParseLetBinding(): /* Let */
{
	Token boundName;
	ASTNode result, initExpr, bodyExpr;
	List<Bind> declarations = new ArrayList<Bind>();
}
{
	(
		result = ParseSequence()
		|
		(
			(
				<LET> boundName = <IDENTIFIER> <BIND> initExpr = ParseLogicalOr() <SEMICOLON>
				{ declarations.add(new Bind(boundName.image, initExpr)); }
			)+ /* + -> 1 or more */
			bodyExpr = ParseSequence()
			{ result = new ASTLet(declarations, bodyExpr); }
		)
	)
	{ return result; }
}

/* ParseSequence ::= ParseAssignmentExpr ( ; ParseAssignmentExpr )* */
ASTNode ParseSequence(): /* Seq */
{
	Token seqSep;
	ASTNode left, right;
}
{
	left = ParseAssignmentExpr()
	(
		seqSep = <SEMICOLON> right = ParseAssignmentExpr()
		{ left = new ASTSeq(left, right); }
	)*
	{ return left; }
}

/* ParseAssignmentExpr ::= ParseLogicalOr ( := ParseLogicalOr )* */
ASTNode ParseAssignmentExpr(): /* SeqExp */
{
	Token assignOp;
	ASTNode left, right;
}
{
	left = ParseLogicalOr()
	(
		assignOp = <ASSIGN> right = ParseLogicalOr()
		{ left = new ASTAssign(left, right); }
	)*
	{ return left; }
}

/* ParseLogicalOr ::= ParseLogicalAnd  ( || ParseLogicalAnd )* */
ASTNode ParseLogicalOr(): /* BA */
{
	Token logicalOp;
	ASTNode left, right;
}
{
	left = ParseLogicalAnd()
	(
		logicalOp = <OR> right = ParseLogicalAnd()
		{ left = new ASTOr(left, right); }
	)*
	{ return left; }
}

/* ParseLogicalAnd ::= ParseComparison ( && ParseComparison )* */
ASTNode ParseLogicalAnd(): /* BM */
{
	Token logicalOp;
	ASTNode left, right;
}
{
	left = ParseComparison()
	(
		logicalOp = <AND> right = ParseComparison()
		{ left = new ASTAnd(left, right); }
	)*
	{ return left; }
}

/* ParseComparison ::= ParseAdditive ( ( == | ~= | > | < | >= | <= ) ParseAdditive )? */
ASTNode ParseComparison(): /* Rel */
{
	ASTNode left, right;
}
{
	left = ParseAdditive()
	(
		  <EQUAL_TO>        right = ParseAdditive() { left = new ASTEq(left, right);   }
		| <GREATER_THAN>    right = ParseAdditive() { left = new ASTGt(left, right);   }
		| <LESS_THAN>       right = ParseAdditive() { left = new ASTLt(left, right);   }
		| <GREATER_THAN_EQ> right = ParseAdditive() { left = new ASTGteq(left, right); }
		| <LESS_THAN_EQ>    right = ParseAdditive() { left = new ASTLteq(left, right); }
		| <NOT_EQUAL_TO>    right = ParseAdditive() { left = new ASTDif(left, right);  }
	)?
	{ return left; }
}

/* ParseAdditive ::= ParseMultiplicativeOrCall ( ( + | - ) ParseMultiplicativeOrCall )* */
ASTNode ParseAdditive(): /* Exp */
{
	Token addOp;
	ASTNode left, right;
}
{
	left = ParseMultiplicativeOrCall()
	(
		addOp = <PLUS>  right = ParseMultiplicativeOrCall() { left = new ASTPlus(left, right); }
		|
		addOp = <MINUS> right = ParseMultiplicativeOrCall() { left = new ASTSub(left, right);  }
	)*
	{ return left; }
}

/* ParseMultiplicativeOrCall ::= ParsePrimary ( ( * | / | ( args ) ) ParsePrimary )* */
ASTNode ParseMultiplicativeOrCall(): /* Term */
{
	Token mulOp;      // captures * or /
	Token callParen;  // captures ( at a function call site
	ASTNode left, right;
}
{
	left = ParsePrimary()
	(
		mulOp = <MULTIPLY> right = ParsePrimary() { left = new ASTMult(left, right); }
		|
		mulOp = <DIVIDE>   right = ParsePrimary() { left = new ASTDiv(left, right);  }
		|
		/* Function application: f(arg1, arg2, ...)
								 f(a, b) -> app(app(f, a), b) */
		<LEFT_PAREN>
		(
			right = ParseLetBinding()
			(
				<RIGHT_PAREN>
				{ left = new ASTApp(left, right); }
				|
				(
					<COMMA> { left = new ASTApp(left, right); }
					right = ParseLetBinding()
				)+
				<RIGHT_PAREN>
				{ left = new ASTApp(left, right); }
			)
		)

		|

		/* f() */
		<UNIT> { left = new ASTApp(left, new ASTUnit()); }
	)*
	{ return left; }
}

/* ParseFunctionLiteral ::= | id ( , id )* | ParsePrimary */
ASTNode ParseFunctionLiteral(): /* Function */
{
	Token param;
	ASTNode result, current = null, body;
}
{
	(
		// Multi-param: |x, y| body -> abs(x, abs(y, body))
		<BAR>
			param = <IDENTIFIER>
			{
				result = new ASTFun(param.image, null);
				current = result;
			}
			(
				<COMMA> param = <IDENTIFIER>
				{
					body = new ASTFun(param.image, null);
					((ASTFun) current).setBody(body);
					current = body;
				}
			)*
		<BAR> body = ParsePrimary()
			{
				((ASTFun) current).setBody(body);
			}

		|

		// No-param shorthand: || body
		<OR> body=ParsePrimary()
			{
				result = new ASTFun("_", body);
			}
	)
	{ return result; }
}

/* ParseStructTuple ::= <TAG> ( <LEFT_PAREN> ParseLetBinding ( , ParseLetBinding )* <RIGHT_PAREN>  |  <UNIT> ) */
ASTNode ParseStructTuple(): /* StructTuple */
{
	Token tag;
	ASTNode elem;
	List<ASTNode> elems = new ArrayList<ASTNode>();
}
{
	tag = <TAG>
	(
		// Multi-param: #Color(9,2,3)
		<LEFT_PAREN>
			elem = ParseLetBinding() { elems.add(elem); }
			( <COMMA> elem = ParseLetBinding() { elems.add(elem); } )*
		<RIGHT_PAREN>

		|

		// No-param shorthand: #Tag()
		<UNIT>
		{ elems.add(new ASTUnit()); }
	)
	{ return new ASTStructTuple(tag.image, elems); }
}

/* ParseMatchExpr ::=
		match ParseLetBinding {
			ParseStructPattern => ParseLetBinding
			else => ParseLetBinding
		}
*/
ASTNode ParseMatchExpr(): /* Match */
{
	ASTNode targetExpr, matchBranch, elseBranch;
	ASTStructPattern pattern;
}
{
	/* Example: match e { #Color(r,g,b) => r+g+b, else => -1 } */
	<MATCH> targetExpr = ParseLetBinding()
	<LEFT_BRACE>
		pattern = ParseStructPattern()
			   <ARROW> matchBranch = ParseLetBinding()
		<ELSE> <ARROW> elseBranch  = ParseLetBinding()
	<RIGHT_BRACE>
	{ return new ASTMatch(targetExpr, pattern, matchBranch, elseBranch); }
}

/* ParseStructPattern ::= <TAG> ( <LEFT_PAREN> id ( , id )* <RIGHT_PAREN>  |  <UNIT> ) */
ASTStructPattern ParseStructPattern(): /* Pattern */
{
	Token tag, param;
	List<String> params = new ArrayList<String>();
}
{
	tag = <TAG>
	(
		<LEFT_PAREN>
			param = <IDENTIFIER> { params.add(param.image); }
			( <COMMA> param = <IDENTIFIER> { params.add(param.image); } )*
		<RIGHT_PAREN>
		|
		<UNIT>
		{ params.add("_");}
	)
	{ return new ASTStructPattern(tag.image, params); }
}

/* ParsePrimary ::=
	   INTEGER_LITERAL | true | false | ()  | STRING_LITERAL | id
	 | - ParsePrimary | ~ ParsePrimary
	 | ParseFunctionLiteral
	 | if ParseLogicalOr { ParseLetBinding } else { ParseLetBinding }
	 | print!   ParsePrimary
	 | println! ParsePrimary
	 | while ParseLogicalOr { ParseLetBinding }
	 | cell ParsePrimary
	 | ! ParsePrimary
	 | ( ParseLetBinding )
	 | { ParseLetBinding }
	 | ParseStructTuple
	 | ParseMatchExpr
*/
ASTNode ParsePrimary(): /* Primary */
{
	Token tok;
	ASTNode result, thenBranch, elseBranch, body;
}
{
	(
		  tok = <INTEGER_LITERAL> { result = new ASTInt(Integer.parseInt(tok.image)); }
		| tok = <TRUE>            { result = new ASTBool(true);                       }
		| tok = <FALSE>           { result = new ASTBool(false);                      }
		| tok = <UNIT>            { result = new ASTUnit();                           }
		| tok = <STRING_LITERAL>  { result = new ASTString(tok.image);                }
		| tok = <IDENTIFIER>      { result = new ASTId(tok.image);                    }

		| <MINUS> result = ParsePrimary() { result = new ASTNeg(result); }
		| <NOT>   result = ParsePrimary() { result = new ASTNot(result); }

		| result = ParseFunctionLiteral()

		| <IF> result = ParseLogicalOr()
		  <LEFT_BRACE>  thenBranch = ParseLetBinding() <RIGHT_BRACE>
		  <ELSE>
		  <LEFT_BRACE>  elseBranch = ParseLetBinding() <RIGHT_BRACE>
		  { result = new ASTIf(result, thenBranch, elseBranch); }

		| <PRINT>   result = ParsePrimary() { result = new ASTPrint(result);   }
		| <PRINTLN> result = ParsePrimary() { result = new ASTPrintln(result); }

		| <WHILE> result = ParseLogicalOr()
		  <LEFT_BRACE> body = ParseLetBinding() <RIGHT_BRACE>
		  { result = new ASTWhile(result, body); }

		| <CELL>  result = ParsePrimary() { result = new ASTCell(result);  }
		| <DEREF> result = ParsePrimary() { result = new ASTDeref(result); }

		| <LEFT_PAREN>  result = ParseLetBinding() <RIGHT_PAREN>
		| <LEFT_BRACE>  result = ParseLetBinding() <RIGHT_BRACE>

		| result = ParseStructTuple()
		| result = ParseMatchExpr()
	)
	{ return result; }
}
